rules_version = '2';

// Deploy with:  firebase deploy --only firestore:rules
//
// Anyone may read the wall of names and write exactly one hoist record. Nothing
// can ever be edited or deleted, and the shape of a record is pinned down here
// rather than trusted from the browser.
//
// This is open by design — there is no sign-in. If the app gets scraped or
// spammed, turn on Firebase App Check (see README) which blocks writes that do
// not come from your own page.

service cloud.firestore {
  match /databases/{database}/documents {

    match /hoists/{hoist} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly(['name', 'at', 'day'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 28
        && request.resource.data.at is timestamp
        && request.resource.data.day is string
        && request.resource.data.day.size() == 10;

      allow update, delete: if false;
    }

    // Nothing else in the database is reachable from the browser.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
