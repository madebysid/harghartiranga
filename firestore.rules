rules_version = '2';

// Deploy with:  firebase deploy --only firestore:rules
//
// This database holds one thing: how many times the flag has been hoisted. One
// record per hoist, carrying nothing but when it happened.
//
// Names are deliberately not here. People type a name to put on their own
// certificate and into their own share message, and that name never leaves their
// browser. Storing it would have meant a public wall of user-supplied text, and
// no rule can judge whether a name is offensive — so the wall is gone and with it
// the only risk that could not be defended against. It also halves the writes.
//
// There is no sign-in, so this file is the only thing standing between the
// collection and the open internet. It has to assume every field is hostile.

service cloud.firestore {
  match /databases/{database}/documents {

    // Client clocks are wrong more often than you would think — a cheap handset
    // can be hours out — so this is generous in the past and tight in the future.
    // A ceiling matters because records are ordered by time: without one, a
    // record dated 2099 would sit at the head of the collection forever.
    function sane(ts) {
      return ts is timestamp
        && ts > request.time - duration.value(48, 'h')
        && ts < request.time + duration.value(2, 'h');
    }

    match /hoists/{hoist} {
      // Public: the count is read from here once every ten minutes by CI, which
      // publishes it as a static file. Browsers never read this collection.
      allow read: if true;

      // One hoist, and nothing about who made it.
      //
      // `name` is tolerated only while empty, so a browser still running the
      // previous build cannot write one and cannot be broken by this rule. It is
      // not written by the current app at all.
      allow create: if
        request.resource.data.keys().hasAll(['at', 'day'])
        && request.resource.data.keys().hasOnly(['at', 'day', 'name'])
        && sane(request.resource.data.at)
        && request.resource.data.day is string
        && request.resource.data.day.size() == 10
        && (!('name' in request.resource.data) || request.resource.data.name == '');

      // A hoist is a fact about a moment. Nothing can revise it afterwards, and
      // nothing can erase it. The previous build allowed one update — an empty
      // name becoming a real one — which is what signing used to do; with names
      // out of the database that permission has no purpose and is withdrawn.
      allow update, delete: if false;
    }

    // Nothing else in the database is reachable from the browser.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
