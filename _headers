# Response headers for hosts that read this file — Cloudflare Pages and Netlify.
# Firebase Hosting uses firebase.json instead, and GitHub Pages cannot set headers
# at all, so a site served from Pages runs without any of this.
#
# Keep this in step with the "headers" block in firebase.json. The policy that
# earns its keep is script-src 'self': every script the app runs is a file in this
# repo and none are inline, so an injected <script> cannot execute. connect-src
# has to name the font hosts as well as Firestore, because the service worker
# fetches fonts and a worker's fetch answers to connect-src.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self' https://firestore.googleapis.com https://madebysid.github.io https://fonts.googleapis.com https://fonts.gstatic.com; manifest-src 'self'; worker-src 'self'; base-uri 'none'; object-src 'none'; form-action 'self'; frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()

# Regenerated by CI every ten minutes, so a long cache would make the counter
# look frozen.
/wall.json
  Cache-Control: public, max-age=60, must-revalidate

# The worker itself must never be served from cache, or a deploy cannot replace it.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Code and markup revalidate every time; the worker is what makes that cheap.
/*.js
  Cache-Control: public, max-age=0, must-revalidate
/*.css
  Cache-Control: public, max-age=0, must-revalidate

# Art and audio are effectively immutable — the filename changes when they do.
/*.svg
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/*.mp3
  Cache-Control: public, max-age=2592000
